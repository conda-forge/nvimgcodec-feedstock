From b966c8a7ae07022740dbdf8ae51e0c322b68953b Mon Sep 17 00:00:00 2001
From: Daniel Ching <dching@nvidia.com>
Date: Tue, 4 Feb 2025 17:33:47 -0600
Subject: [PATCH 1/3] BLD: Move CMake config install directory

---
 src/CMakeLists.txt | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 07a4d6ff..78ab651e 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -180,7 +180,7 @@ endif()
 #   * <prefix>/${NVIMGCODEC_INSTALL_CMAKEDIR}/
 #   * <prefix>/${NVIMGCODEC_INSTALL_LIBDIR}/
 #   * <prefix>/${NVIMGCODEC_INSTALL_INCLUDEDIR}/
-set(config_install_dir "${NVIMGCODEC_INSTALL_CMAKEDIR}")
+set(config_install_dir "${CMAKE_INSTALL_PREFIX}/lib/cmake")
 
 set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
 
@@ -252,7 +252,7 @@ install(
 #   * <prefix>/${NVIMGCODEC_INSTALL_CMAKEDIR}/nvimgcodecConfigVersion.cmake
 install(
     FILES "${project_config}" "${version_config}"
-    DESTINATION "${config_install_dir}"
+    DESTINATION "${config_install_dir}/nvimgcodec"
     COMPONENT lib
 )
 
@@ -261,7 +261,7 @@ install(
 install(
     EXPORT "${TARGETS_EXPORT_NAME}"
     NAMESPACE "${namespace}"
-    DESTINATION "${config_install_dir}"
+    DESTINATION "${config_install_dir}/nvimgcodec"
     COMPONENT lib
 )
 
